{
  "version": 1,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/feedback-hook\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/feedback-hook\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__plugin_cloudfleet_cloudfleet__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/feedback-hook\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/feedback-hook\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/feedback-hook\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/feedback-hook\"",
            "timeout": 5
          }
        ]
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "\"${COPILOT_PLUGIN_ROOT}/scripts/feedback-hook\" copilot postToolUse",
        "timeoutSec": 5,
        "matcher": "^(bash|cloudfleet-.*)$"
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "\"${COPILOT_PLUGIN_ROOT}/scripts/feedback-hook\" copilot postToolUseFailure",
        "timeoutSec": 5,
        "matcher": "^(bash|cloudfleet-.*)$"
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "\"${COPILOT_PLUGIN_ROOT}/scripts/feedback-hook\" copilot userPromptSubmitted",
        "timeoutSec": 5
      }
    ]
  }
}
