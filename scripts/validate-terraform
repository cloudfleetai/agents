#!/usr/bin/env bash
# PreToolUse hook: checks a terraform plan/apply/destroy that uses the Cloudfleet
# provider before it reaches an organization.
#
# - A `dev_overrides` entry for the provider in the Terraform CLI config outranks
#   the pinned version and bypasses .terraform.lock.hcl. Terraform reports it as
#   one warning among normal output, so a local build can mutate real
#   infrastructure unnoticed.
# - apply and destroy act on whichever organization the credentials resolve to.
#   When CLOUDFLEET_ORGANIZATION_ID, the provider block and the profile name
#   different organizations, a stale export can silently redirect the run.
#
# plan gets the override finding as context for Claude. apply and destroy ask the
# operator to confirm only when one of the two signals is present: prompting on
# every apply would train people to click through. Anything the hook cannot
# resolve is left to Terraform: no output, exit 0.

set -uo pipefail

PROVIDER='terraform.cloudfleet.ai/cloudfleet/cloudfleet'

command -v jq >/dev/null 2>&1 || exit 0

INPUT=$(cat)
COMMAND=$(printf '%s' "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
[ -n "$COMMAND" ] || exit 0
CWD=$(printf '%s' "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)
[ -n "$CWD" ] || CWD=$PWD

# shellcheck source=lib/command-parse.sh
. "${0%/*}/lib/command-parse.sh"

resolve_path() {
    local base="$1" p="$2"
    case "$p" in
        "~") printf '%s' "$HOME" ;;
        "~/"*) printf '%s/%s' "$HOME" "${p#\~/}" ;;
        /*) printf '%s' "$p" ;;
        *) printf '%s/%s' "$base" "$p" ;;
    esac
}

# Walks the segments in order, following `cd` so `cd infra && terraform apply`
# checks infra/. apply or destroy anywhere in the command outranks a plan.
SUBCOMMAND=""
TF_DIR=""
dir=$CWD
set -f
while IFS= read -r seg; do
    # shellcheck disable=SC2086
    set -- $seg
    [ $# -gt 0 ] || continue
    case "$1" in
        cd)
            if [ $# -ge 2 ]; then dir=$(resolve_path "$dir" "$2"); else dir=$HOME; fi
            ;;
        terraform | */terraform)
            shift
            chdir=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    -chdir=*) chdir=${1#-chdir=} ;;
                    -*) ;;
                    *) break ;;
                esac
                shift
            done
            target=$dir
            [ -n "$chdir" ] && target=$(resolve_path "$dir" "$chdir")
            case "${1:-}" in
                apply | destroy)
                    SUBCOMMAND=$1
                    TF_DIR=$target
                    break
                    ;;
                plan)
                    if [ -z "$SUBCOMMAND" ]; then SUBCOMMAND=plan; TF_DIR=$target; fi
                    ;;
            esac
            ;;
    esac
done < <(command_segments "$COMMAND")
set +f

[ -n "$SUBCOMMAND" ] || exit 0
[ -d "$TF_DIR" ] || exit 0

# The lock file catches a provider pulled in only through a module.
uses_cloudfleet() {
    local f
    for f in "$1"/*.tf "$1"/*.tf.json "$1"/.terraform.lock.hcl; do
        [ -f "$f" ] && grep -qF "$PROVIDER" "$f" && return 0
    done
    return 1
}
uses_cloudfleet "$TF_DIR" || exit 0

# A variable set on the command line (`VAR=x terraform apply`, `export VAR=x; ...`)
# wins over the hook's own environment, which is the session's.
command_env() {
    local name="$1" v
    v=$(printf '%s' "$COMMAND" |
        grep -oE "(^|[[:space:];&|])$name=('[^']*'|\"[^\"]*\"|[^[:space:];&|]+)" |
        tail -1 |
        sed -E -e "s/^[[:space:];&|]*$name=//" -e "s/^['\"]//" -e "s/['\"]$//")
    if [ -n "$v" ]; then printf '%s' "$v"; else printf '%s' "${!name:-}"; fi
}

# Prints the body of every block whose header matches $1, comments dropped.
# Brace counting is naive about braces inside strings, which these blocks
# (provider settings, override paths) do not normally contain.
block_body() {
    awk -v hdr="$1" '
    { sub(/[[:space:]]*(#|\/\/).*$/, "") }
    !inblk && $0 ~ hdr { inblk = 1; depth = 0 }
    inblk {
        print
        depth += gsub(/\{/, "{") - gsub(/\}/, "}")
        if (depth <= 0) inblk = 0
    }'
}

# --- dev_overrides -----------------------------------------------------------

CLI_CONFIG=$(command_env TF_CLI_CONFIG_FILE)
CLI_CONFIG=${CLI_CONFIG:-$HOME/.terraformrc}
CLI_CONFIG=$(resolve_path "$CWD" "$CLI_CONFIG")

OVERRIDE_PATH=""
if [ -f "$CLI_CONFIG" ]; then
    OVERRIDE_PATH=$(block_body 'dev_overrides[[:space:]]*\{' <"$CLI_CONFIG" |
        grep -F "\"$PROVIDER\"" |
        head -1 |
        sed -nE 's/.*"[^"]*"[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p')
fi

OVERRIDE_MSG=""
if [ -n "$OVERRIDE_PATH" ]; then
    OVERRIDE_MSG="$CLI_CONFIG has a dev_overrides entry for $PROVIDER pointing at $OVERRIDE_PATH. Terraform will run that local build instead of the version pinned in .terraform.lock.hcl."
fi

if [ "$SUBCOMMAND" = plan ]; then
    [ -n "$OVERRIDE_MSG" ] || exit 0
    jq -n --arg ctx "Cloudfleet provider check: $OVERRIDE_MSG Tell the operator before relying on this plan, and before any apply." \
        '{hookSpecificOutput: {hookEventName: "PreToolUse", additionalContext: $ctx}}'
    exit 0
fi

# --- organization ------------------------------------------------------------

PROVIDER_BLOCK=""
for f in "$TF_DIR"/*.tf; do
    [ -f "$f" ] && PROVIDER_BLOCK+=$(block_body '^[[:space:]]*provider[[:space:]]+"cloudfleet"[[:space:]]*\{' <"$f")$'\n'
done

provider_attr() {
    printf '%s' "$PROVIDER_BLOCK" |
        sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*(.*[^[:space:]])[[:space:]]*$/\1/p" |
        head -1
}

credentials_file() {
    local f
    for f in "$HOME/Library/Application Support/cloudfleet/credentials.json" \
        "${XDG_CONFIG_HOME:-$HOME/.config}/cloudfleet/credentials.json"; do
        [ -f "$f" ] && { printf '%s' "$f"; return 0; }
    done
    return 1
}

# Reads only non-secret fields from the profile.
profile_field() {
    local creds key="${2//./-}"
    creds=$(credentials_file) || return 0
    jq -r --arg p "$key" --arg k "$1" '.profiles[$p][$k] // empty' "$creds" 2>/dev/null
}

unquote() { sed -E 's/^"(.*)"$/\1/'; }

LINES=()
ORGS=()

ENV_ORG=$(command_env CLOUDFLEET_ORGANIZATION_ID)
if [ -n "$ENV_ORG" ]; then
    LINES+=("CLOUDFLEET_ORGANIZATION_ID: $ENV_ORG")
    ORGS+=("$ENV_ORG")
fi

BLOCK_ORG=$(provider_attr organization_id)
case "$BLOCK_ORG" in
    "") ;;
    \"*\")
        BLOCK_ORG=$(printf '%s' "$BLOCK_ORG" | unquote)
        LINES+=("provider block organization_id: $BLOCK_ORG")
        ORGS+=("$BLOCK_ORG")
        ;;
    *) LINES+=("provider block organization_id: set from $BLOCK_ORG (not resolved here)") ;;
esac

BLOCK_PROFILE=$(provider_attr profile)
case "$BLOCK_PROFILE" in
    \"*\") PROFILE=$(printf '%s' "$BLOCK_PROFILE" | unquote); PROFILE_SRC="provider block" ;;
    "")
        PROFILE=$(command_env CLOUDFLEET_PROFILE)
        if [ -n "$PROFILE" ]; then PROFILE_SRC="CLOUDFLEET_PROFILE"; else PROFILE=default; PROFILE_SRC="default"; fi
        ;;
    *) PROFILE=""; LINES+=("provider block profile: set from $BLOCK_PROFILE (not resolved here)") ;;
esac

if [ -n "$PROFILE" ]; then
    PROFILE_ORG=$(profile_field organization_id "$PROFILE")
    PROFILE_API=$(profile_field api_server "$PROFILE")
    if [ -n "$PROFILE_ORG" ]; then
        line="profile '$PROFILE' ($PROFILE_SRC): organization $PROFILE_ORG"
        [ -n "$PROFILE_API" ] && line+=", api_server $PROFILE_API"
        LINES+=("$line")
        ORGS+=("$PROFILE_ORG")
    fi
fi

ENDPOINT=$(command_env CLOUDFLEET_ENDPOINT)
BLOCK_ENDPOINT=$(provider_attr endpoint)
[ -n "$BLOCK_ENDPOINT" ] && LINES+=("provider block endpoint: $BLOCK_ENDPOINT")
[ -n "$ENDPOINT" ] && LINES+=("CLOUDFLEET_ENDPOINT: $ENDPOINT")

DISTINCT_ORGS=$(printf '%s\n' "${ORGS[@]+"${ORGS[@]}"}" | sort -u | grep -c .)

[ -n "$OVERRIDE_MSG" ] || [ "$DISTINCT_ORGS" -gt 1 ] || exit 0

REASON="terraform $SUBCOMMAND in $TF_DIR uses the Cloudfleet provider."
[ -n "$OVERRIDE_MSG" ] && REASON+=$'\n\n'"WARNING: $OVERRIDE_MSG"
if [ "$DISTINCT_ORGS" -gt 1 ]; then
    REASON+=$'\n\n'"WARNING: these settings name different organizations. Which one applies depends on where the credentials come from (environment tokens, provider-block tokens, or the profile)."
fi
if [ ${#LINES[@]} -gt 0 ]; then
    REASON+=$'\n\n'"Organization settings found:"
    for l in "${LINES[@]}"; do REASON+=$'\n'"  - $l"; done
fi
REASON+=$'\n\n'"Confirm this is the provider build and organization you intend to use."

jq -n --arg r "$REASON" \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask", permissionDecisionReason: $r}}'
exit 0
