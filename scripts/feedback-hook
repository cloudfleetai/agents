#!/usr/bin/env bash
# Feedback prompts, modelled on the Stripe plugin's lifecycle hooks (0.11.17):
# at moments when there is Cloudfleet work to judge, tell the agent to assess it and
# send Cloudfleet feedback after the user approves the draft.
#
# The first argument names the harness: none for Claude Code, `codex` for Codex.
#
# Claude Code
# Event                 Condition                                       Rate
# PostToolUseFailure    cloudfleet: skill, Cloudfleet MCP tool, or a     always
#                       `cloudfleet` CLI command failed
# PostToolBatch         the batch used Cloudfleet and nothing failed     PER_TOOL_RATE
# PostToolUse (Agent)   a completed subagent's work mentions Cloudfleet  PER_TOOL_RATE
# UserPromptSubmit      the previous turn mentions Cloudfleet            PER_TURN_RATE
#
# Codex has no failure or batch events, and no Agent or Skill tool.
# PostToolUse           a `cloudfleet` command exited non-zero, or a     always
#                       Cloudfleet MCP tool returned an error
# PostToolUse           the same calls when they succeeded               PER_TOOL_RATE
# UserPromptSubmit      the previous turn mentions Cloudfleet            PER_TURN_RATE
# Codex fires no PostToolUse for an MCP call that fails outright, and passes
# Bash output without the exit code, which is read from the transcript instead.
# Its `decision: block` replaces the tool result, so every Codex prompt is
# additionalContext.
#
# Sampled prompts fire at most once per session. Failures steer every time,
# except failures of the feedback command itself.
#
# The feedback_send MCP tool works with any CLI, because `cloudfleet mcp`
# forwards every request to the server; `cloudfleet feedback` needs 1.10.0. So
# nothing fires without a CLI, and the CLI command is offered only from 1.10.0.
#
# Always exits 0: feedback guidance must never interrupt the agent's work.

set -uo pipefail

PER_TURN_RATE=10 # percent
PER_TOOL_RATE=1  # percent
MIN_CLI_VERSION=1.10.0
TRANSCRIPT_TAIL_BYTES=1048576
MENTION_RE='cloudfleet|cfke|cfcr'

HARNESS=${1:-claude}
case "$HARNESS" in
    claude) MCP_PREFIX='mcp__plugin_cloudfleet_cloudfleet__' MANIFEST=.claude-plugin/plugin.json ;;
    codex) MCP_PREFIX='mcp__cloudfleet__' MANIFEST=.codex-plugin/plugin.json ;;
    *) exit 0 ;;
esac

command -v jq >/dev/null 2>&1 || exit 0

INPUT=$(cat)
field() { printf '%s' "$INPUT" | jq -r "$1 // empty" 2>/dev/null; }

EVENT=$(field .hook_event_name)
SESSION=$(field .session_id | tr -cd 'A-Za-z0-9_-')
[ -n "$EVENT" ] || exit 0

# shellcheck source=lib/command-parse.sh
. "${0%/*}/lib/command-parse.sh"

MARKER_DIR=${TMPDIR:-/tmp}
ASKED="${MARKER_DIR%/}/cloudfleet-feedback-${SESSION:-nosession}"

# Overridable so tests are deterministic.
sampled() { [ "${CLOUDFLEET_FEEDBACK_ROLL:-$((RANDOM % 100))}" -lt "$1" ]; }

# The feedback command is excluded so a failed send does not ask for feedback
# about itself; `cloudfleet mcp` is the MCP server, covered by the MCP matcher.
runs_cloudfleet() {
    command_segments "$1" |
        grep -E '^([^[:space:]]*/)?cloudfleet([[:space:]]|$)' |
        grep -qvE '^([^[:space:]]*/)?cloudfleet[[:space:]]+(feedback|mcp)([[:space:]]|$)'
}

# Takes {tool_name, tool_input} JSON.
is_cloudfleet_call() {
    local name
    name=$(printf '%s' "$1" | jq -r '.tool_name // empty' 2>/dev/null)
    case "$name" in
        "${MCP_PREFIX}feedback_send") return 1 ;;
        "$MCP_PREFIX"*) return 0 ;;
        Skill) case "$(printf '%s' "$1" | jq -r '.tool_input.skill // empty')" in cloudfleet:*) return 0 ;; esac ;;
        Bash) runs_cloudfleet "$(printf '%s' "$1" | jq -r '.tool_input.command // empty')" && return 0 ;;
    esac
    return 1
}

# Unparseable versions (dev builds) count as older.
cli_has_feedback() {
    local v want have i
    v=$(cloudfleet --version 2>/dev/null | awk '{print $NF}' | sed -E 's/^v//; s/[-+].*$//')
    printf '%s' "$v" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$' || return 1
    IFS=. read -ra have <<<"$v"
    IFS=. read -ra want <<<"$MIN_CLI_VERSION"
    for i in 0 1 2; do
        [ "${have[$i]}" -gt "${want[$i]}" ] && return 0
        [ "${have[$i]}" -lt "${want[$i]}" ] && return 1
    done
    return 0
}

# The previous turn runs from the last human prompt to the end of the transcript.
# Text, tool calls, tool results and hook output all count, as in Stripe's
# transcriptHelpers.mjs. A window with no human prompt in it is scanned whole.
last_turn_mentions_cloudfleet() {
    local t
    printf '%s' "$(field .last_assistant_message)" | grep -qiE "$MENTION_RE" && return 0
    t=$(field .transcript_path)
    [ -f "$t" ] || return 1
    tail -c "$TRANSCRIPT_TAIL_BYTES" "$t" | tail -n +2 |
        jq -R 'fromjson?' |
        jq -se --arg re "$MENTION_RE" '
            def txt: if type == "string" then . elif . == null then "" else tojson end;
            def results: if type == "string" then .
                elif type == "array" then map(if type == "object" and .type == "text" then (.text | txt) else "" end) | join("\n")
                else "" end;
            def block: if type == "string" then .
                elif type != "object" then ""
                elif .type == "text" then (.text | txt)
                elif .type == "tool_use" then (.name | txt) + "\n" + (.input | txt)
                elif .type == "tool_result" then (.content | results)
                else "" end;
            def content: if type == "string" then . elif type == "array" then map(block) | join("\n") else "" end;
            def hook_output: if ((.type? // "") | tostring | startswith("hook_"))
                then [.content, .stdout, .stderr] | map(txt) | join("\n") else "" end;
            def text: ((.message.content? // null) | content) + "\n" + ((.attachment? // null) | hook_output);
            def human: .type == "user" and (.isMeta != true) and (.isSynthetic != true)
                and ((.message.content | type) == "string"
                     or ((.message.content | type) == "array" and any(.message.content[]; .type? != "tool_result")));
            . as $e
            | ([range(0; $e | length) | select($e[.] | human)] | last // 0) as $start
            | $e[$start:] | any(.[]; text | test($re; "i"))
        ' >/dev/null 2>&1
}

batch_failed() {
    printf '%s' "$1" | jq -e '
        def failed: if type == "array" then any(.[]; failed)
            elif type == "object" then (.is_error == true or .isError == true or (.error | failed) or (.content | failed))
            elif type == "string" then test("^\\s*(error\\b|exit code \\d+\\b|mcp error\\b|tool use error\\b|<tool_use_error>)"; "i")
            else false end;
        .tool_response | failed' >/dev/null 2>&1
}

# Codex writes each command's exit code to the transcript before PostToolUse
# fires, keyed by the hook's tool_use_id.
codex_exit_code() {
    local t id
    t=$(field .transcript_path)
    id=$(field .tool_use_id)
    [ -f "$t" ] && [ -n "$id" ] || return 0
    tail -c "$TRANSCRIPT_TAIL_BYTES" "$t" | grep -F "\"id\":\"$id\"" |
        jq -r 'select(.payload.item.type? == "CommandExecution") | .payload.item.exit_code // empty' 2>/dev/null |
        tail -n 1
}

codex_call_failed() {
    local code
    case "$(field .tool_name)" in
        Bash)
            code=$(codex_exit_code)
            [ -n "$code" ] && [ "$code" != 0 ]
            ;;
        *) batch_failed "$INPUT" ;;
    esac
}

# The previous turn runs from the task_started before the last task_complete to
# that task_complete. Only conversation items are scanned: the session preamble
# lists every installed skill, and cwd may itself contain "cloudfleet".
codex_last_turn_mentions_cloudfleet() {
    local t
    t=$(field .transcript_path)
    [ -f "$t" ] || return 1
    tail -c "$TRANSCRIPT_TAIL_BYTES" "$t" | tail -n +2 |
        jq -R 'fromjson?' |
        jq -se --arg re "$MENTION_RE" '
            [.[] | select(.type? == "event_msg") | .payload] as $p
            | ([range(0; $p | length) | select($p[.].type? == "task_complete")] | last) as $end
            | $end != null
              and (([range(0; $end) | select($p[.].type? == "task_started")] | last // 0) as $start
                   | $p[$start:$end]
                   | map(select(.type? == "item_completed") | .item
                         | select(.type? | IN("UserMessage", "AgentMessage", "CommandExecution", "McpToolCall"))
                         | del(.cwd, .id, .process_id))
                   | any(.[]; tojson | test($re; "i")))
        ' >/dev/null 2>&1
}

KIND=""
case "$HARNESS:$EVENT" in
    codex:PostToolUse)
        is_cloudfleet_call "$INPUT" || exit 0
        if codex_call_failed; then
            KIND=failure
        else
            [ -e "$ASKED" ] && exit 0
            sampled "$PER_TOOL_RATE" || exit 0
            KIND=tool
        fi
        ;;
    codex:UserPromptSubmit)
        [ -e "$ASKED" ] && exit 0
        sampled "$PER_TURN_RATE" || exit 0
        codex_last_turn_mentions_cloudfleet || exit 0
        KIND=turn
        ;;
    claude:PostToolUseFailure)
        [ "$(field .is_interrupt)" = true ] && exit 0
        is_cloudfleet_call "$INPUT" || exit 0
        KIND=failure
        ;;
    claude:PostToolBatch)
        [ -e "$ASKED" ] && exit 0
        used=false
        while IFS= read -r call; do
            is_cloudfleet_call "$call" || continue
            batch_failed "$call" && exit 0
            used=true
        done < <(printf '%s' "$INPUT" | jq -c '.tool_calls[]? | objects' 2>/dev/null)
        [ "$used" = true ] || exit 0
        sampled "$PER_TOOL_RATE" || exit 0
        KIND=batch
        ;;
    claude:PostToolUse)
        [ "$(field .tool_name)" = Agent ] || exit 0
        [ "$(field .tool_response.status)" = completed ] || exit 0
        [ -e "$ASKED" ] && exit 0
        printf '%s' "$INPUT" | jq -r '[.tool_input.prompt, .tool_response.content] | map(if type == "string" then . else tojson end) | join("\n")' |
            grep -qiE "$MENTION_RE" || exit 0
        sampled "$PER_TOOL_RATE" || exit 0
        KIND=agent
        ;;
    claude:UserPromptSubmit)
        [ -e "$ASKED" ] && exit 0
        sampled "$PER_TURN_RATE" || exit 0
        last_turn_mentions_cloudfleet || exit 0
        KIND=turn
        ;;
    *) exit 0 ;;
esac

command -v cloudfleet >/dev/null 2>&1 || exit 0

PLUGIN_VERSION=$(jq -r '.version // empty' "${0%/*}/../$MANIFEST" 2>/dev/null)
CLIENT="cloudfleet-plugin-$HARNESS/${PLUGIN_VERSION:-unknown}"

CRITERIA="If it was useful, confusing, wrong, or incomplete, send Cloudfleet feedback."
if cli_has_feedback; then
    EXAMPLE="Use the \`feedback_send\` MCP tool or the CLI, for example: \`cloudfleet feedback --sentiment neutral --message \"The fleet docs did not say constraints default to amd64\" --context \"Creating a Hetzner fleet with Terraform\" --source plugin --client $CLIENT\`."
else
    EXAMPLE="Use the \`feedback_send\` MCP tool, for example with sentiment \"neutral\", message \"The fleet docs did not say constraints default to amd64\", context \"Creating a Hetzner fleet with Terraform\", and client \"$CLIENT\". The installed CLI predates \`cloudfleet feedback\` (1.10.0), so do not use the CLI command."
fi
OPTIONS="Use positive, neutral, or negative honestly. Do not include secrets, kubeconfig contents, or customer data. Feedback is for one-way notes: if the user needs an answer or Cloudfleet must look into their environment, offer a support ticket instead, and for a concrete feature request offer the roadmap (see the \`cloudfleet:contact\` skill)."
APPROVAL="Before submitting, show the prospective feedback to the user and ask for approval, mentioning that the Cloudfleet team reads feedback but does not reply, so anything that needs an answer belongs in a support ticket."

case "$KIND" in
    failure) MSG="The Cloudfleet tool failed. Send Cloudfleet feedback explaining what you were trying to do and what failed. $EXAMPLE $OPTIONS Then continue resolving the failure and the user's task. $APPROVAL" ;;
    batch) MSG="Assess the Cloudfleet skills, MCP tools, or CLI commands used in this batch. If any were useful, confusing, wrong, or incomplete, send Cloudfleet feedback. $EXAMPLE $OPTIONS Then continue the user's task. $APPROVAL" ;;
    tool) MSG="Assess the Cloudfleet MCP tool or CLI command you just used. $CRITERIA $EXAMPLE $OPTIONS Then continue the user's task. $APPROVAL" ;;
    agent) MSG="Assess the completed subagent's Cloudfleet-related work. $CRITERIA $EXAMPLE $OPTIONS Then continue the user's task. $APPROVAL" ;;
    turn) MSG="Assess the preceding Cloudfleet work before handling the new message. $CRITERIA $EXAMPLE $OPTIONS Then continue by responding to the user's new message. $APPROVAL" ;;
esac

if [ "$KIND" = failure ] && [ "$HARNESS" = claude ]; then
    jq -n --arg r "$MSG" '{decision: "block", reason: $r}'
else
    [ "$KIND" = failure ] || : >"$ASKED" 2>/dev/null
    jq -n --arg e "$EVENT" --arg c "$MSG" '{hookSpecificOutput: {hookEventName: $e, additionalContext: $c}}'
fi
exit 0
