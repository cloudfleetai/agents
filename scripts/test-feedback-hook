#!/usr/bin/env bash
# Test suite for the feedback hook. Uses a fake `cloudfleet` on PATH for the
# version gate, a private TMPDIR for the per-session markers, and a fixed
# CLOUDFLEET_FEEDBACK_ROLL so sampling is deterministic.

set -uo pipefail

HOOK="$(cd "$(dirname "$0")" && pwd)/feedback-hook"
PLUGIN_VERSION=$(jq -r .version "$(dirname "$HOOK")/../.claude-plugin/plugin.json")
MCP=mcp__plugin_cloudfleet_cloudfleet__
passed=0
failed=0

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
mkdir -p "$T/bin" "$T/markers"

fake_cli() {
    printf '#!/bin/sh\necho "cloudfleet version %s"\n' "$1" >"$T/bin/cloudfleet"
    chmod +x "$T/bin/cloudfleet"
}
fake_cli 1.10.0

session=0
new_session() { session=$((session + 1)); }

# Transcript fixtures, one JSON object per line as Claude Code writes them. The
# first line stands in for the partial line a byte-offset tail starts with.
human() { jq -cn --arg t "$1" '{type: "user", message: {content: $t}}'; }
said() { jq -cn --arg t "$1" '{type: "assistant", message: {content: [{type: "text", text: $t}]}}'; }
used() { jq -cn --arg n "$1" --argjson i "$2" '{type: "assistant", message: {content: [{type: "tool_use", name: $n, input: $i}]}}'; }
result() { jq -cn --arg t "$1" '{type: "user", message: {content: [{type: "tool_result", content: $t}]}}'; }
transcript() { local f="$T/$1.jsonl"; shift; { echo '{"partial'; printf '%s\n' "$@"; } >"$f"; printf '%s' "$f"; }

T_TOOL=$(transcript tool "$(human 'list my stuff')" "$(used "${MCP}clusters_list" '{}')" "$(said 'Done.')")
T_RESULT=$(transcript result "$(human 'what is running?')" "$(used Bash '{"command":"kubectl get ns"}')" "$(result 'cfke-system   Active')")
T_TEXT=$(transcript text "$(human 'hi')" "$(said 'Your CFCR registry is ready.')")
T_OLD=$(transcript old "$(human 'old question')" "$(said 'Cloudfleet answer')" "$(human 'unrelated')" "$(said 'Sure, here is a poem.')")
T_HOOK=$(transcript hook "$(human 'run it')" '{"type":"attachment","attachment":{"type":"hook_success","stdout":"Blocked: not a CFKE cluster"}}')
T_NOHUMAN=$(transcript nohuman "$(said 'cloudfleet clusters list returned 2 clusters')")

# Codex transcript fixtures: conversation items arrive as item_completed events
# between task_started and task_complete.
cx_event() { jq -cn --argjson p "$1" '{type: "event_msg", payload: $p}'; }
cx_started() { cx_event '{"type":"task_started"}'; }
cx_complete() { cx_event '{"type":"task_complete"}'; }
cx_item() { cx_event "$(jq -cn --argjson i "$1" '{type: "item_completed", item: $i}')"; }
cx_user() { cx_item "$(jq -cn --arg t "$1" '{type: "UserMessage", content: [{type: "text", text: $t}]}')"; }
cx_said() { cx_item "$(jq -cn --arg t "$1" '{type: "AgentMessage", content: [{type: "Text", text: $t}]}')"; }
cx_cmd() { cx_item "$(jq -cn --arg id "$1" --arg c "$2" --argjson e "$3" '{type: "CommandExecution", id: $id, command: ["/bin/zsh", "-lc", $c], cwd: "file:///home/me/cloudfleet-infra", aggregated_output: "", exit_code: $e}')"; }
cx_preamble() { jq -cn '{type: "response_item", payload: {type: "message", role: "developer", content: [{type: "input_text", text: "Skills: cloudfleet:setup, cloudfleet:debug-cluster"}]}}'; }

CX_CLI=$(transcript cx-cli "$(cx_preamble)" "$(cx_started)" "$(cx_user 'what is running?')" "$(cx_cmd exec-1 'cloudfleet clusters list' 0)" "$(cx_said 'Two clusters.')" "$(cx_complete)" "$(cx_started)")
CX_TEXT=$(transcript cx-text "$(cx_started)" "$(cx_user 'hi')" "$(cx_said 'Your CFCR registry is ready.')" "$(cx_complete)")
CX_OLD=$(transcript cx-old "$(cx_started)" "$(cx_said 'Cloudfleet answer')" "$(cx_complete)" "$(cx_started)" "$(cx_user 'unrelated')" "$(cx_said 'Sure, here is a poem.')" "$(cx_complete)")
CX_NOISE=$(transcript cx-noise "$(cx_preamble)" "$(cx_started)" "$(cx_user 'tidy the repo')" "$(cx_cmd exec-2 'git status' 0)" "$(cx_said 'Clean.')" "$(cx_complete)")
CX_FIRST=$(transcript cx-first "$(cx_preamble)" "$(cx_started)")
CX_EXIT=$(transcript cx-exit "$(cx_started)" "$(cx_cmd exec-ok 'cloudfleet clusters list' 0)" "$(cx_cmd exec-bad 'cloudfleet clusters describe x' 75)")

# run <roll> <event json, without session_id> [hook arguments] -> hook stdout
run() {
    printf '%s' "$2" |
        jq -c --arg s "test-$session" '. + {session_id: $s}' |
        PATH="$T/bin:$PATH" TMPDIR="$T/markers" CLOUDFLEET_FEEDBACK_ROLL="$1" "$HOOK" ${3:-} 2>/dev/null
}

kind() {
    if [ -z "$1" ]; then echo none
    elif printf '%s' "$1" | jq -e '.decision == "block" and (.reason | length > 0)' >/dev/null 2>&1; then echo steer
    elif printf '%s' "$1" | jq -e '(.hookSpecificOutput.additionalContext // .additionalContext) | length > 0' >/dev/null 2>&1; then echo context
    else echo "invalid output"
    fi
}

# expect <none|context|steer> <description> <roll> <event json> [hook arguments]
expect() {
    local want="$1" desc="$2" got
    LAST_OUT=$(run "$3" "$4" "${5:-}")
    got=$(kind "$LAST_OUT")
    if [ "$got" = "$want" ]; then
        printf '  ok       %s\n' "$desc"
        passed=$((passed + 1))
    else
        printf '  FAIL     %s (wanted %s, got %s)\n' "$desc" "$want" "$got"
        failed=$((failed + 1))
    fi
}

check() {
    if eval "$2"; then
        printf '  ok       %s\n' "$1"
        passed=$((passed + 1))
    else
        printf '  FAIL     %s\n' "$1"
        failed=$((failed + 1))
    fi
}

failure() { local i='{}'; [ $# -ge 2 ] && i=$2; jq -cn --arg n "$1" --argjson i "$i" '{hook_event_name: "PostToolUseFailure", tool_name: $n, tool_input: $i, error: "boom", is_interrupt: false}'; }
bash_failure() { failure Bash "$(jq -cn --arg c "$1" '{command: $c}')"; }
batch() { jq -cn --argjson c "$1" '{hook_event_name: "PostToolBatch", tool_calls: $c}'; }
agent() { jq -cn --arg p "$1" --arg r "$2" --arg s "${3:-completed}" '{hook_event_name: "PostToolUse", tool_name: "Agent", tool_input: {prompt: $p}, tool_response: {status: $s, content: [{type: "text", text: $r}]}}'; }
prompt() { jq -cn --arg t "$1" '{hook_event_name: "UserPromptSubmit", prompt: "next", transcript_path: $t}'; }

echo "Tool failure (steers every time):"
new_session
expect steer "Cloudfleet MCP tool" 99 "$(failure "${MCP}clusters_get")"
check "steer names the plugin client" 'printf "%s" "$LAST_OUT" | grep -qF "cloudfleet-plugin-claude/$PLUGIN_VERSION"'
check "steer uses only flags the CLI has" '! printf "%s" "$LAST_OUT" | grep -qF -- "--area"'
expect steer "again in the same session" 99 "$(failure "${MCP}clusters_get")"
expect steer "cloudfleet: skill" 99 "$(failure Skill '{"skill":"cloudfleet:cluster-setup"}')"
expect steer "cloudfleet CLI command" 99 "$(bash_failure 'cloudfleet clusters list')"
expect steer "cloudfleet later in a command line" 99 "$(bash_failure 'cd infra && cloudfleet clusters list | jq .')"
expect none "feedback_send itself" 99 "$(failure "${MCP}feedback_send")"
expect none "cloudfleet feedback itself" 99 "$(bash_failure 'cloudfleet feedback --sentiment negative --message x')"
expect none "another plugin's skill" 99 "$(failure Skill '{"skill":"stripe:test-cards"}')"
expect none "another MCP server" 99 "$(failure mcp__github__get_issue)"
expect none "kubectl" 99 "$(bash_failure 'kubectl get pods')"
expect none "cloudfleet only in a path" 99 "$(bash_failure 'cd ~/projects/cloudfleet && make')"
expect none "interrupted by the user" 99 "$(failure "${MCP}clusters_get" | jq -c '.is_interrupt = true')"

echo
echo "Tool batch (sampled, once per session):"
ok_call=$(jq -cn --arg n "${MCP}clusters_list" '{tool_name: $n, tool_input: {}, tool_response: [{type: "text", text: "[]"}]}')
cli_call='{"tool_name":"Bash","tool_input":{"command":"cloudfleet clusters list"},"tool_response":{"stdout":"[]"}}'
bad_call=$(jq -cn --arg n "${MCP}clusters_get" '{tool_name: $n, tool_input: {}, tool_response: {isError: true}}')
bad_cli='{"tool_name":"Bash","tool_input":{"command":"cloudfleet clusters get x"},"tool_response":"Exit code 1\nnot found"}'
read_call='{"tool_name":"Read","tool_input":{"file_path":"/x"},"tool_response":"cloudfleet"}'
new_session
expect none "roll above the rate" 1 "$(batch "[$ok_call]")"
expect context "Cloudfleet MCP tool, roll under the rate" 0 "$(batch "[$read_call,$ok_call]")"
check "context names the event" '[ "$(printf "%s" "$LAST_OUT" | jq -r .hookSpecificOutput.hookEventName)" = PostToolBatch ]'
expect none "second ask in the same session" 0 "$(batch "[$ok_call]")"
new_session
expect context "cloudfleet CLI command" 0 "$(batch "[$cli_call]")"
new_session
expect none "a Cloudfleet call failed (the failure hook covers it)" 0 "$(batch "[$ok_call,$bad_call]")"
expect none "a cloudfleet command exited non-zero" 0 "$(batch "[$bad_cli]")"
expect none "no Cloudfleet call" 0 "$(batch "[$read_call]")"

echo
echo "Subagent (sampled, once per session):"
new_session
expect none "roll above the rate" 1 "$(agent 'Diagnose the CFKE cluster' 'Found the issue')"
expect context "completed work mentioning Cloudfleet" 0 "$(agent 'Diagnose the cluster' 'The cloudfleet fleet is not ready')"
expect none "second ask in the same session" 0 "$(agent 'Diagnose the CFKE cluster' 'ok')"
new_session
expect none "no mention" 0 "$(agent 'Refactor the parser' 'Done')"
expect none "not completed" 0 "$(agent 'Diagnose the CFKE cluster' 'ok' running)"

echo
echo "Prompt after a turn mentioning Cloudfleet (sampled, once per session):"
new_session
expect none "roll above the rate" 10 "$(prompt "$T_TOOL")"
expect context "MCP tool call in the last turn" 0 "$(prompt "$T_TOOL")"
check "context names the event" '[ "$(printf "%s" "$LAST_OUT" | jq -r .hookSpecificOutput.hookEventName)" = UserPromptSubmit ]'
expect none "second ask in the same session" 0 "$(prompt "$T_TOOL")"
new_session
expect context "tool result in the last turn" 0 "$(prompt "$T_RESULT")"
new_session
expect context "assistant text in the last turn" 0 "$(prompt "$T_TEXT")"
new_session
expect context "hook output in the last turn" 0 "$(prompt "$T_HOOK")"
new_session
expect context "no human prompt in the window: scanned whole" 0 "$(prompt "$T_NOHUMAN")"
new_session
expect context "last_assistant_message in the event" 0 \
    "$(prompt "$T/missing.jsonl" | jq -c '.last_assistant_message = "Cloudfleet cluster created"')"
new_session
expect none "mention only in an earlier turn" 0 "$(prompt "$T_OLD")"
expect none "missing transcript" 0 "$(prompt "$T/missing.jsonl")"

echo
echo "Codex tool calls (failures always, successes sampled once per session):"
CX=mcp__cloudfleet__
cx_bash() { jq -cn --arg c "$1" --arg id "$2" --arg t "$CX_EXIT" '{hook_event_name: "PostToolUse", tool_name: "Bash", tool_input: {command: $c}, tool_response: "out", tool_use_id: $id, transcript_path: $t}'; }
cx_mcp() { jq -cn --arg n "$CX$1" --argjson r "$2" '{hook_event_name: "PostToolUse", tool_name: $n, tool_input: {}, tool_response: $r}'; }
cx_prompt() { jq -cn --arg t "$1" '{hook_event_name: "UserPromptSubmit", prompt: "next", transcript_path: $t}'; }
new_session
expect context "cloudfleet command exited non-zero" 99 "$(cx_bash 'cloudfleet clusters describe x' exec-bad)" codex
check "names the Codex client" 'printf "%s" "$LAST_OUT" | grep -qF "cloudfleet-plugin-codex/$(jq -r .version "$(dirname "$HOOK")/../.codex-plugin/plugin.json")"'
check "prompts as context, never a block" '! printf "%s" "$LAST_OUT" | jq -e .decision >/dev/null'
expect context "again in the same session" 99 "$(cx_bash 'cloudfleet clusters describe x' exec-bad)" codex
expect context "MCP tool returned an error" 99 "$(cx_mcp clusters_get '{"content":[{"type":"text","text":"not found"}],"isError":true}')" codex
expect none "cloudfleet command succeeded, roll above the rate" 1 "$(cx_bash 'cloudfleet clusters list' exec-ok)" codex
expect none "exit code not in the transcript" 1 "$(cx_bash 'cloudfleet clusters list' exec-missing)" codex
expect none "Claude's MCP prefix" 99 "$(cx_mcp clusters_get '{"isError":true}' | jq -c --arg n "${MCP}clusters_get" '.tool_name = $n')" codex
expect none "cloudfleet feedback itself" 99 "$(cx_bash 'cloudfleet feedback --message x' exec-bad)" codex
expect none "kubectl" 99 "$(cx_bash 'kubectl get pods' exec-bad)" codex
expect context "MCP tool succeeded, roll under the rate" 0 "$(cx_mcp who_am_i '{"content":[{"type":"text","text":"{}"}]}')" codex
check "context names the event" '[ "$(printf "%s" "$LAST_OUT" | jq -r .hookSpecificOutput.hookEventName)" = PostToolUse ]'
expect none "second ask in the same session" 0 "$(cx_bash 'cloudfleet clusters list' exec-ok)" codex
expect context "failures still prompt after an ask" 99 "$(cx_bash 'cloudfleet clusters describe x' exec-bad)" codex

echo
echo "Codex prompt after a turn mentioning Cloudfleet (sampled, once per session):"
new_session
expect none "roll above the rate" 10 "$(cx_prompt "$CX_CLI")" codex
expect context "cloudfleet command in the last turn" 0 "$(cx_prompt "$CX_CLI")" codex
expect none "second ask in the same session" 0 "$(cx_prompt "$CX_CLI")" codex
new_session
expect context "assistant text in the last turn" 0 "$(cx_prompt "$CX_TEXT")" codex
new_session
expect none "mention only in an earlier turn" 0 "$(cx_prompt "$CX_OLD")" codex
expect none "only the skill list and cwd mention cloudfleet" 0 "$(cx_prompt "$CX_NOISE")" codex
expect none "first prompt of the session" 0 "$(cx_prompt "$CX_FIRST")" codex
expect none "missing transcript" 0 "$(cx_prompt "$T/missing.jsonl")" codex
expect none "unknown harness" 0 "$(cx_prompt "$CX_CLI")" cursor

echo
echo "Copilot (camelCase payloads, event name passed as an argument):"
cp_bash() { jq -cn --arg c "$1" --arg out "$2" '{sessionId: "S", toolName: "bash", toolArgs: {command: $c}, toolResult: {resultType: "success", textResultForLlm: $out}}' | jq -c --arg s "test-$session" '.sessionId = $s'; }
cp_mcp() { jq -cn --arg n "cloudfleet-$1" --arg s "test-$session" '{sessionId: $s, toolName: $n, toolArgs: {}, toolResult: {resultType: "success", textResultForLlm: "{}"}}'; }
cp_fail() { jq -cn --arg n "cloudfleet-$1" --arg s "test-$session" '{sessionId: $s, toolName: $n, toolArgs: {}, error: "not found"}'; }
cp_prompt() { jq -cn --arg s "test-$session" '{sessionId: $s, prompt: "next"}'; }
new_session
expect context "cloudfleet command exited non-zero" 99 "$(cp_bash 'cloudfleet clusters describe x' $'{"error":{}}\n<shellId: 0 completed with exit code 66>')" "copilot postToolUse"
check "names the Copilot client" 'printf "%s" "$LAST_OUT" | grep -qF "cloudfleet-plugin-copilot/$PLUGIN_VERSION"'
check "top-level additionalContext" 'printf "%s" "$LAST_OUT" | jq -e ".additionalContext | length > 0" >/dev/null'
expect none "cloudfleet command exited 0, roll above the rate" 1 "$(cp_bash 'cloudfleet clusters list' $'[]\n<shellId: 0 completed with exit code 0>')" "copilot postToolUse"
expect none "non-zero exit of another command" 99 "$(cp_bash 'kubectl get pods' $'x\n<shellId: 0 completed with exit code 1>')" "copilot postToolUse"
expect none "cloudfleet feedback itself" 99 "$(cp_bash 'cloudfleet feedback --message x' $'x\n<shellId: 0 completed with exit code 1>')" "copilot postToolUse"
expect context "MCP tool failed" 99 "$(cp_fail clusters_get)" "copilot postToolUseFailure"
expect none "feedback_send failed" 99 "$(cp_fail feedback_send)" "copilot postToolUseFailure"
expect context "next prompt after a Cloudfleet call" 0 "$(cp_prompt)" "copilot userPromptSubmitted"
expect none "following prompt: marker consumed" 0 "$(cp_prompt)" "copilot userPromptSubmitted"
new_session
expect none "prompt without a Cloudfleet call" 0 "$(cp_prompt)" "copilot userPromptSubmitted"
expect context "MCP call succeeded, roll under the rate" 0 "$(cp_mcp who_am_i)" "copilot postToolUse"
expect none "second ask in the same session" 0 "$(cp_prompt)" "copilot userPromptSubmitted"
new_session
c_failure=$(failure "${MCP}clusters_get")
out=$(printf '%s' "$c_failure" | jq -c '. + {session_id: "cp"}' | COPILOT_PLUGIN_ROOT=/x PATH="$T/bin:$PATH" TMPDIR="$T/markers" CLOUDFLEET_FEEDBACK_ROLL=0 "$HOOK" 2>/dev/null)
check "Claude-format entries are ignored under Copilot" '[ -z "$out" ]'

echo
echo "Antigravity (PostToolUse records, PreInvocation prompts):"
AG_T="$T/ag-transcript.jsonl"
printf '%s\n' '{"step_index":4,"type":"GENERIC","content":"Command exited with code 66.\n\nCommand output:\nError: not found"}' \
    '{"step_index":6,"type":"GENERIC","content":"Command exited with code 0.\n\nCommand output:\n[]"}' >"$AG_T"
ag_cmd() { jq -cn --arg c "$1" --argjson i "$2" --arg t "$AG_T" --arg s "test-$session" '{conversationId: $s, transcriptPath: $t, stepIdx: $i, error: "", toolCall: {name: "run_command", args: {CommandLine: $c}}}'; }
ag_mcp() { jq -cn --arg n "$1" --arg e "${2:-}" --arg s "test-$session" '{conversationId: $s, stepIdx: 9, error: $e, toolCall: {name: "call_mcp_tool", args: {ServerName: "cloudfleet_cloudfleet", ToolName: $n, Arguments: {}}}}'; }
ag_inv() { jq -cn --argjson n "$1" --arg t "$AG_T" --arg s "test-$session" '{conversationId: $s, transcriptPath: $t, invocationNum: $n}'; }
ag_injects() { printf '%s' "$LAST_OUT" | jq -e '.injectSteps[0].ephemeralMessage | length > 0' >/dev/null 2>&1; }
new_session
LAST_OUT=$(run 99 "$(ag_cmd 'cloudfleet clusters describe x' 4)" "antigravity PostToolUse")
check "PostToolUse answers {} and prompts nothing" '[ "$LAST_OUT" = "{}" ]'
LAST_OUT=$(run 99 "$(ag_inv 2)" "antigravity PreInvocation")
check "next PreInvocation: command exited non-zero" 'ag_injects && printf "%s" "$LAST_OUT" | grep -qF "The Cloudfleet tool failed"'
check "  ...names the Antigravity client" 'printf "%s" "$LAST_OUT" | grep -qF "cloudfleet-plugin-antigravity/$PLUGIN_VERSION"'
LAST_OUT=$(run 99 "$(ag_inv 3)" "antigravity PreInvocation")
check "pending calls are consumed" '[ "$LAST_OUT" = "{}" ]'
run 99 "$(ag_mcp clusters_get 'Cluster not found')" "antigravity PostToolUse" >/dev/null
LAST_OUT=$(run 99 "$(ag_inv 4)" "antigravity PreInvocation")
check "MCP call failed" 'ag_injects'
run 99 "$(ag_cmd 'cloudfleet clusters list' 6)" "antigravity PostToolUse" >/dev/null
LAST_OUT=$(run 1 "$(ag_inv 5)" "antigravity PreInvocation")
check "command succeeded, roll above the rate: nothing" '[ "$LAST_OUT" = "{}" ]'
run 99 "$(ag_cmd 'kubectl get pods' 4)" "antigravity PostToolUse" >/dev/null
LAST_OUT=$(run 99 "$(ag_inv 6)" "antigravity PreInvocation")
check "another command failed: nothing" '[ "$LAST_OUT" = "{}" ]'
run 99 "$(ag_mcp feedback_send 'boom')" "antigravity PostToolUse" >/dev/null
LAST_OUT=$(run 99 "$(ag_inv 7)" "antigravity PreInvocation")
check "feedback_send failed: nothing" '[ "$LAST_OUT" = "{}" ]'
LAST_OUT=$(run 0 "$(ag_inv 0)" "antigravity PreInvocation")
check "first call of the next turn assesses the Cloudfleet turn" 'ag_injects && printf "%s" "$LAST_OUT" | grep -qF "Assess the preceding Cloudfleet work"'
LAST_OUT=$(run 0 "$(ag_inv 0)" "antigravity PreInvocation")
check "the turn after that: nothing" '[ "$LAST_OUT" = "{}" ]'
new_session
run 99 "$(ag_mcp who_am_i)" "antigravity PostToolUse" >/dev/null
LAST_OUT=$(run 0 "$(ag_inv 1)" "antigravity PreInvocation")
check "MCP call succeeded, roll under the rate" 'ag_injects'
run 99 "$(ag_mcp who_am_i)" "antigravity PostToolUse" >/dev/null
LAST_OUT=$(run 0 "$(ag_inv 2)" "antigravity PreInvocation")
check "second ask in the same session: nothing" '[ "$LAST_OUT" = "{}" ]'

echo
echo "CLI version (feedback_send works through any CLI, \`cloudfleet feedback\` needs 1.10.0+):"
offers_cli='printf "%s" "$LAST_OUT" | grep -qF "cloudfleet feedback --sentiment"'
for v in 1.9.9 1.2.0 dev; do
    fake_cli "$v"
    expect steer "CLI $v still steers" 99 "$(failure "${MCP}clusters_get")"
    check "  ...to the MCP tool only" "! $offers_cli && printf '%s' \"\$LAST_OUT\" | grep -qF feedback_send"
done
for v in 1.10.0 1.12.3 2.0.0; do
    fake_cli "$v"
    expect steer "CLI $v steers" 99 "$(failure "${MCP}clusters_get")"
    check "  ...offering the CLI command too" "$offers_cli"
done
# A PATH with the hook's dependencies but no cloudfleet, real or fake.
nocli=$(mktemp -d)
for b in bash jq grep cat sed tr head tail awk; do
    ln -s "$(command -v "$b")" "$nocli/$b" 2>/dev/null
done
out=$(failure "${MCP}clusters_get" | jq -c '. + {session_id: "nocli"}' |
    env -i PATH="$nocli" TMPDIR="$T/markers" CLOUDFLEET_FEEDBACK_ROLL=0 "$HOOK" 2>/dev/null)
check "CLI not installed: no output" '[ -z "$out" ]'
rm -rf "$nocli"

echo
echo "hooks/hooks.json layout (shared by Claude Code, Copilot CLI and Antigravity):"
HOOKS_JSON="$(dirname "$HOOK")/../hooks/hooks.json"
# Antigravity decodes the file with Go, which matches keys case-insensitively
# and keeps the last one, so Copilot's postToolUse must come before PostToolUse.
check "postToolUse precedes PostToolUse" \
    'jq -e ".hooks | keys_unsorted | (index(\"postToolUse\") < index(\"PostToolUse\"))" "$HOOKS_JSON" >/dev/null'
# Antigravity reads every top-level key as a named hook and rejects the file if
# one is not an object (a Copilot-style "version": 1 did that).
check "only the hooks key at the top level" '[ "$(jq -c "keys" "$HOOKS_JSON")" = "[\"hooks\"]" ]'

echo
echo "Missing jq fails open:"
d=$(mktemp -d)
for b in bash grep cat sed tr head tail awk; do
    ln -s "$(command -v "$b")" "$d/$b" 2>/dev/null
done
ln -s "$T/bin/cloudfleet" "$d/cloudfleet"
out=$(printf '{"hook_event_name":"PostToolUseFailure","session_id":"x","tool_name":"%sclusters_get"}' "$MCP" |
    env -i PATH="$d" TMPDIR="$T/markers" CLOUDFLEET_FEEDBACK_ROLL=0 "$HOOK" 2>/dev/null)
rc=$?
check "jq missing: exit 0, no output" '[ "$rc" -eq 0 ] && [ -z "$out" ]'
rm -rf "$d"

echo
printf '%s passed, %s failed\n' "$passed" "$failed"
[ "$failed" -eq 0 ]
