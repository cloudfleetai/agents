#!/usr/bin/env bash
# Test suite for the validate-terraform hook.
#
# Runs entirely against fixtures in a temporary HOME: no Terraform, no network,
# and the caller's real ~/.terraformrc and Cloudfleet profiles are never read.

set -uo pipefail

HOOK="$(cd "$(dirname "$0")" && pwd)/validate-terraform"
passed=0
failed=0

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT

FAKE_HOME="$T/home"
CF="$T/cf"          # working dir using the Cloudfleet provider
OTHER="$T/other"    # working dir using some other provider
mkdir -p "$FAKE_HOME/.config/cloudfleet" "$CF/sub" "$OTHER"

cat >"$CF/versions.tf" <<'EOF'
terraform {
  required_providers {
    cloudfleet = { source = "terraform.cloudfleet.ai/cloudfleet/cloudfleet" }
  }
}
EOF
cp "$CF/versions.tf" "$CF/sub/versions.tf"
printf 'provider "aws" {\n  profile = "prod"\n}\n' >"$OTHER/main.tf"

cat >"$FAKE_HOME/.config/cloudfleet/credentials.json" <<'EOF'
{"profiles": {
  "default": {"organization_id": "org-default", "type": "user"},
  "staging": {"organization_id": "org-staging", "api_server": "https://api.staging.example/v1", "type": "user"}
}}
EOF

OVERRIDE_RC="$T/override.tfrc"
cat >"$OVERRIDE_RC" <<'EOF'
provider_installation {
  dev_overrides {
    "terraform.cloudfleet.ai/cloudfleet/cloudfleet" = "/home/dev/go/bin"
  }
  direct {}
}
EOF

COMMENTED_RC="$T/commented.tfrc"
cat >"$COMMENTED_RC" <<'EOF'
provider_installation {
  dev_overrides {
    # "terraform.cloudfleet.ai/cloudfleet/cloudfleet" = "/home/dev/go/bin"
    "registry.terraform.io/hashicorp/aws" = "/home/dev/aws"
  }
  direct {}
}
EOF

# run <cwd> <command> [VAR=value ...] -> prints the hook's stdout
run() {
    local cwd="$1" cmd="$2"
    shift 2
    jq -n --arg c "$cmd" --arg d "$cwd" '{cwd: $d, tool_input: {command: $c}}' |
        env -u CLOUDFLEET_ORGANIZATION_ID -u CLOUDFLEET_PROFILE -u CLOUDFLEET_ENDPOINT \
            -u TF_CLI_CONFIG_FILE -u XDG_CONFIG_HOME HOME="$FAKE_HOME" "$@" "$HOOK" 2>/dev/null
}

classify() {
    local out="$1"
    if [ -z "$out" ]; then echo none
    elif printf '%s' "$out" | jq -e '.hookSpecificOutput.permissionDecision == "ask"' >/dev/null 2>&1; then echo ask
    elif printf '%s' "$out" | jq -e '.hookSpecificOutput.additionalContext' >/dev/null 2>&1; then echo context
    else echo "unknown"
    fi
}

# expect <none|context|ask> <description> <needle-or-empty> <cwd> <command> [VAR=value ...]
expect() {
    local want="$1" desc="$2" needle="$3" out got
    shift 3
    out=$(run "$@")
    got=$(classify "$out")
    if [ "$got" != "$want" ]; then
        printf '  FAIL     %s (wanted %s, got %s)\n' "$desc" "$want" "$got"
        failed=$((failed + 1))
    elif [ -n "$needle" ] && ! printf '%s' "$out" | grep -qF -- "$needle"; then
        printf '  FAIL     %s (output lacks "%s")\n' "$desc" "$needle"
        failed=$((failed + 1))
    else
        printf '  ok       %s\n' "$desc"
        passed=$((passed + 1))
    fi
}

echo "Not a terraform plan/apply/destroy:"
expect none "commit message mentioning terraform apply" "" \
    "$CF" 'git commit -m "run terraform apply later"'
expect none "terraform init" "" "$CF" 'terraform init'
expect none "terraform validate" "" "$CF" 'terraform validate' TF_CLI_CONFIG_FILE="$OVERRIDE_RC"
expect none "heredoc body containing terraform apply" "" \
    "$CF" "$(printf 'cat > run.sh <<EOF\nterraform apply -auto-approve\nEOF\n')" TF_CLI_CONFIG_FILE="$OVERRIDE_RC"

echo
echo "Working dir without the Cloudfleet provider:"
expect none "apply with a dev override present" "" \
    "$OTHER" 'terraform apply' TF_CLI_CONFIG_FILE="$OVERRIDE_RC"

echo
echo "Clean setup stays silent:"
expect none "plan, no override" "" "$CF" 'terraform plan'
expect none "apply, no override, one organization" "" "$CF" 'terraform apply'
expect none "apply, env org matches profile" "" \
    "$CF" 'terraform apply' CLOUDFLEET_ORGANIZATION_ID=org-default
expect none "override for another provider only, comment ignored" "" \
    "$CF" 'terraform apply' TF_CLI_CONFIG_FILE="$COMMENTED_RC"

echo
echo "dev_overrides for the Cloudfleet provider:"
expect context "plan gets context" "/home/dev/go/bin" \
    "$CF" 'terraform plan' TF_CLI_CONFIG_FILE="$OVERRIDE_RC"
expect ask "apply asks" "/home/dev/go/bin" \
    "$CF" 'terraform apply -auto-approve' TF_CLI_CONFIG_FILE="$OVERRIDE_RC"
expect ask "destroy asks" "dev_overrides" \
    "$CF" 'terraform destroy' TF_CLI_CONFIG_FILE="$OVERRIDE_RC"
expect ask "TF_CLI_CONFIG_FILE set on the command line" "dev_overrides" \
    "$CF" "TF_CLI_CONFIG_FILE=$OVERRIDE_RC terraform apply"
cp "$OVERRIDE_RC" "$FAKE_HOME/.terraformrc"
expect ask "~/.terraformrc read by default" "$FAKE_HOME/.terraformrc" "$CF" 'terraform apply'
expect ask "plan then apply in one command counts as apply" "" "$CF" 'terraform plan && terraform apply'
rm "$FAKE_HOME/.terraformrc"

echo
echo "Organization sources that disagree:"
expect ask "env org differs from default profile" "org-elsewhere" \
    "$CF" 'terraform apply' CLOUDFLEET_ORGANIZATION_ID=org-elsewhere
expect ask "env org on the command line" "org-inline" \
    "$CF" 'CLOUDFLEET_ORGANIZATION_ID=org-inline terraform apply'
expect ask "CLOUDFLEET_PROFILE picks the profile, shows api_server" "api.staging.example" \
    "$CF" 'terraform apply' CLOUDFLEET_PROFILE=staging CLOUDFLEET_ORGANIZATION_ID=org-default
expect none "plan does not ask about organizations" "" \
    "$CF" 'terraform plan' CLOUDFLEET_ORGANIZATION_ID=org-elsewhere
printf 'provider "cloudfleet" {\n  organization_id = "org-block"\n}\n' >"$CF/provider.tf"
expect ask "provider block org differs from profile" "org-block" "$CF" 'terraform apply'
printf 'provider "cloudfleet" {\n  profile = "staging"\n  organization_id = "org-staging"\n}\n' >"$CF/provider.tf"
expect none "provider block profile and org agree" "" "$CF" 'terraform apply'
rm "$CF/provider.tf"

echo
echo "Working directory resolution:"
expect ask "cd <dir> && terraform apply" "$CF/sub" \
    "$T" 'cd cf/sub && terraform apply' TF_CLI_CONFIG_FILE="$OVERRIDE_RC"
expect ask "terraform -chdir=<dir> apply" "$CF/sub" \
    "$T" 'terraform -chdir=cf/sub apply' TF_CLI_CONFIG_FILE="$OVERRIDE_RC"
expect none "cd into a non-Cloudfleet dir" "" \
    "$CF" "cd $OTHER && terraform apply" TF_CLI_CONFIG_FILE="$OVERRIDE_RC"

echo
echo "Missing jq fails open:"
d=$(mktemp -d)
for b in bash grep cat sed tr head tail awk sort env; do
    ln -s "$(command -v "$b")" "$d/$b" 2>/dev/null
done
out=$(printf '%s' '{"tool_input":{"command":"terraform apply"}}' |
    env -i PATH="$d" HOME="$FAKE_HOME" TF_CLI_CONFIG_FILE="$OVERRIDE_RC" "$HOOK" 2>/dev/null)
rc=$?
if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
    printf '  ok       jq missing allows\n'
    passed=$((passed + 1))
else
    printf '  FAIL     jq missing exited %s with output "%s"\n' "$rc" "$out"
    failed=$((failed + 1))
fi
rm -rf "$d"

echo
printf '%s passed, %s failed\n' "$passed" "$failed"
[ "$failed" -eq 0 ]
